<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#000000">
    <meta name="description" content="Xybant AI — Minimal, intelligent decision architecture.">
    <title>Xybant AI — Think. Decide. Act.</title>

    <!-- PWA Manifest Inline Data URI -->
    <link rel="manifest" href="data:application/manifest+json;base64,">

    <!-- Third-Party Lightweight Markdown Parser (Marked) -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <style>
        /* ==========================================================================
           1. CORE DESIGN SYSTEM & VARIABLES
           ========================================================================== */
        :root {
            --bg-black: #000000;
            --surface-dark: #0a0a0c;
            --accent-blue: #3B82F6;
            --accent-purple: #8B5CF6;
            --accent-glow: rgba(59, 130, 246, 0.25);
            --text-main: #FFFFFF;
            --text-muted: #A1A1AA;
            --border-glow: rgba(255, 255, 255, 0.08);
            --glass-bg: rgba(18, 18, 20, 0.65);
            --glass-blur: blur(24px);
            --font-stack: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
            --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
            --code-bg: rgba(0, 0, 0, 0.5);
        }

        /* Light Theme Overrides */
        [data-theme="light"] {
            --bg-black: #F4F4F5;
            --surface-dark: #FFFFFF;
            --text-main: #09090B;
            --text-muted: #71717A;
            --border-glow: rgba(0, 0, 0, 0.08);
            --glass-bg: rgba(255, 255, 255, 0.7);
            --code-bg: rgba(240, 240, 243, 0.9);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-black);
            color: var(--text-main);
            font-family: var(--font-stack);
            font-feature-settings: "cv02", "cv03", "cv04", "cv11";
            -webkit-font-smoothing: antialiased;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        :focus-visible {
            outline: 2px solid var(--accent-blue);
            outline-offset: 3px;
        }

        /* ==========================================================================
           2. CANVAS ANIMATED BACKGROUND
           ========================================================================== */
        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        /* ==========================================================================
           3. APPLICATION LAYOUT
           ========================================================================== */
        .app-container {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            height: 100vh;
            height: 100dvh;
            max-width: 900px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 0;
            height: 72px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            text-decoration: none;
            color: var(--text-main);
            border-radius: 8px;
        }

        .logo-svg {
            width: 32px;
            height: 32px;
            filter: drop-shadow(0 0 10px rgba(139, 92, 246, 0.4));
        }

        .logo-text {
            font-weight: 600;
            font-size: 0.95rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .icon-btn {
            background: transparent;
            border: none;
            color: var(--text-main);
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.2s ease, background 0.2s ease;
        }

        .icon-btn:hover {
            opacity: 0.8;
            background: rgba(255, 255, 255, 0.05);
        }

        /* ==========================================================================
           4. SIDE DRAWER MENU & SETTINGS
           ========================================================================== */
        .drawer-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 10;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s var(--ease-out), visibility 0.3s;
        }

        .drawer-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .drawer {
            position: fixed;
            top: 0;
            right: -360px;
            width: 360px;
            max-width: 100%;
            height: 100%;
            background: var(--glass-bg);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border-left: 1px solid var(--border-glow);
            z-index: 11;
            padding: 2rem 1.75rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.35s var(--ease-out);
            overflow-y: auto;
        }

        .drawer.active {
            transform: translateX(-360px);
        }

        .drawer-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .drawer-title {
            font-size: 1.1rem;
            font-weight: 600;
            letter-spacing: -0.3px;
        }

        .drawer-section-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--text-muted);
            margin: 1.5rem 0 0.75rem 0;
        }

        .menu-items {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .menu-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 0.85rem;
            border-radius: 12px;
            color: var(--text-main);
            text-decoration: none;
            font-size: 0.95rem;
            cursor: pointer;
            background: transparent;
            border: 1px solid transparent;
            transition: all 0.2s ease;
        }

        .menu-item:hover {
            background: rgba(255, 255, 255, 0.04);
            border-color: var(--border-glow);
        }

        .select-control {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-glow);
            color: var(--text-main);
            padding: 0.35rem 0.6rem;
            border-radius: 8px;
            font-size: 0.85rem;
            outline: none;
        }

        .select-control option {
            background: #121214;
            color: #FFFFFF;
        }

        /* ==========================================================================
           5. HERO SECTION & CHAT FEED
           ========================================================================== */
        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            min-height: 0;
        }

        .hero-section {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 2rem;
            transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
        }

        .hero-section.minimized {
            display: none;
        }

        .hero-title {
            font-size: clamp(2.5rem, 6vw, 4.2rem);
            font-weight: 700;
            letter-spacing: -1.5px;
            background: linear-gradient(180deg, #FFFFFF 0%, #A1A1AA 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
        }

        .hero-subtitle {
            font-size: 1.1rem;
            color: var(--text-muted);
            letter-spacing: 1px;
            font-weight: 300;
            margin-bottom: 1.5rem;
        }

        .status-indicator {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.35rem 0.85rem;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-glow);
            border-radius: 20px;
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .status-dot {
            width: 6px;
            height: 6px;
            background-color: #10B981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10B981;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.85); }
        }

        .chat-feed {
            width: 100%;
            flex: 1;
            overflow-y: auto;
            padding: 1rem 0;
            display: none;
            flex-direction: column;
            gap: 1.5rem;
            scroll-behavior: smooth;
        }

        .chat-feed.active {
            display: flex;
        }

        .chat-feed::-webkit-scrollbar {
            width: 4px;
        }

        .chat-feed::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }

        .message-row {
            display: flex;
            flex-direction: column;
            width: 100%;
            animation: fadeIn 0.3s var(--ease-out) forwards;
        }

        .message-row.user {
            align-items: flex-end;
        }

        .message-row.ai {
            align-items: flex-start;
        }

        .message-bubble {
            max-width: 85%;
            padding: 0.95rem 1.35rem;
            border-radius: 22px;
            font-size: 0.95rem;
            line-height: 1.6;
            letter-spacing: -0.1px;
            position: relative;
            word-break: break-word;
        }

        .message-row.user .message-bubble {
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            color: #FFFFFF;
            border-bottom-right-radius: 4px;
            box-shadow: 0 4px 20px rgba(59, 130, 246, 0.15);
        }

        .message-row.ai .message-bubble {
            background: var(--glass-bg);
            border: 1px solid var(--border-glow);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            color: var(--text-main);
            border-bottom-left-radius: 4px;
        }

        .message-meta {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.4rem;
            padding: 0 0.5rem;
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .message-bubble p { margin-bottom: 0.5rem; }
        .message-bubble p:last-child { margin-bottom: 0; }
        
        .message-bubble code {
            font-family: monospace;
            background: var(--code-bg);
            padding: 0.2rem 0.4rem;
            border-radius: 6px;
            font-size: 0.85em;
        }

        .message-bubble pre {
            background: var(--code-bg);
            border: 1px solid var(--border-glow);
            padding: 0.85rem;
            border-radius: 12px;
            overflow-x: auto;
            margin: 0.75rem 0;
            position: relative;
        }

        .message-bubble pre code {
            background: transparent;
            padding: 0;
        }

        .copy-code-btn {
            position: absolute;
            top: 6px;
            right: 6px;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: var(--text-muted);
            font-size: 0.65rem;
            padding: 0.2rem 0.5rem;
            border-radius: 6px;
            cursor: pointer;
        }

        .copy-code-btn:hover {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.2);
        }

        .message-attachment {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(0, 0, 0, 0.2);
            padding: 0.4rem 0.75rem;
            border-radius: 8px;
            margin-bottom: 0.5rem;
            font-size: 0.8rem;
            border: 1px solid var(--border-glow);
        }

        .typing-indicator {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 0.95rem 1.35rem;
            background: var(--glass-bg);
            border: 1px solid var(--border-glow);
            border-radius: 22px;
            border-bottom-left-radius: 4px;
            width: fit-content;
        }

        .typing-dot {
            width: 5px;
            height: 5px;
            background: var(--text-muted);
            border-radius: 50%;
            animation: typingBounce 1.4s infinite ease-in-out both;
        }

        .typing-dot:nth-child(1) { animation-delay: -0.32s; }
        .typing-dot:nth-child(2) { animation-delay: -0.16s; }

        @keyframes typingBounce {
            0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
            40% { transform: scale(1); opacity: 1; }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==========================================================================
           6. CHAT INPUT & ATTACHMENT DOCK
           ========================================================================== */
        .input-wrapper {
            width: 100%;
            max-width: 760px;
            margin: 0 auto;
            position: relative;
            padding-bottom: 1rem;
        }

        .attachment-preview {
            display: none;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: var(--glass-bg);
            border: 1px solid var(--border-glow);
            backdrop-filter: var(--glass-blur);
            border-radius: 14px;
            margin-bottom: 0.5rem;
            font-size: 0.8rem;
            color: var(--text-muted);
            width: fit-content;
        }

        .attachment-preview.active {
            display: flex;
        }

        .remove-file-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            margin-left: 0.5rem;
        }

        .input-card {
            background: var(--glass-bg);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--border-glow);
            border-radius: 28px;
            padding: 0.5rem 0.75rem 0.5rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .input-card:focus-within {
            border-color: rgba(255, 255, 255, 0.2);
            box-shadow: 0 0 30px var(--accent-glow);
        }

        .chat-textarea {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-main);
            font-family: inherit;
            font-size: 0.95rem;
            resize: none;
            max-height: 140px;
            height: 24px;
            line-height: 24px;
            padding: 0;
        }

        .chat-textarea::placeholder {
            color: var(--text-muted);
        }

        .input-actions {
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .action-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .action-btn:hover {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.05);
        }

        .action-btn.listening {
            color: #EF4444;
            animation: pulse 1.5s infinite;
        }

        .send-btn {
            background: var(--accent-blue);
            color: #FFFFFF;
            box-shadow: 0 0 12px rgba(59, 130, 246, 0.4);
        }

        .send-btn:hover {
            background: #2563EB;
            transform: scale(1.03);
        }

        .send-btn:disabled {
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.2);
            box-shadow: none;
            cursor: not-allowed;
            transform: none;
        }

        footer {
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            color: var(--text-muted);
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        #file-input { display: none; }

        @media (max-width: 640px) {
            .app-container { padding: 0 1rem; }
            .hero-title { font-size: 2.25rem; }
            .hero-subtitle { font-size: 0.95rem; }
            .message-bubble { max-width: 90%; }
            .drawer { width: 100%; right: -100%; }
            .drawer.active { transform: translateX(-100%); }
        }
    </style>
</head>
<body>

    <canvas id="bg-canvas"></canvas>

    <input type="file" id="file-input" accept=".txt,.pdf,.docx,.png,.jpg,.jpeg">

    <div class="app-container">
        <header>
            <a href="#" class="logo" id="logo-btn" aria-label="Xybant AI Home">
                <svg class="logo-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#3B82F6" />
                            <stop offset="100%" stop-color="#8B5CF6" />
                        </linearGradient>
                    </defs>
                    <path d="M 20,20 L 80,80 M 80,20 L 20,80" stroke="url(#logo-grad)" stroke-width="14" stroke-linecap="round" />
                    <circle cx="50" cy="50" r="10" fill="#FFFFFF" />
                </svg>
                <span class="logo-text">Xybant</span>
            </a>
            <button class="icon-btn" id="open-menu-btn" aria-label="Open Navigation Menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="8" x2="20" y2="8"></line>
                    <line x1="4" y1="16" x2="20" y2="16"></line>
                </svg>
            </button>
        </header>

        <main>
            <div class="hero-section" id="hero-section">
                <h1 class="hero-title">XYBANT AI</h1>
                <p class="hero-subtitle">Think. Decide. Act.</p>
                <div class="status-indicator">
                    <span class="status-dot"></span>
                    <span>System Online</span>
                </div>
            </div>

            <div class="chat-feed" id="chat-feed" role="log" aria-live="polite"></div>
        </main>

        <div class="input-wrapper">
            <div class="attachment-preview" id="attachment-preview">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>
                <span id="attachment-name">filename.pdf</span>
                <button class="remove-file-btn" id="remove-file-btn" aria-label="Remove File">✕</button>
            </div>

            <div class="input-card">
                <button class="action-btn" id="attach-btn" aria-label="Attach File">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                    </svg>
                </button>
                
                <textarea class="chat-textarea" id="chat-input" placeholder="Ask Xybant anything..." rows="1" aria-label="Chat input"></textarea>
                
                <div class="input-actions">
                    <button class="action-btn" id="mic-btn" aria-label="Voice Input">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                            <line x1="12" y1="19" x2="12" y2="23"></line>
                        </svg>
                    </button>
                    <button class="action-btn send-btn" id="send-btn" aria-label="Send Message" disabled>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="19" x2="12" y2="5"></line>
                            <polyline points="5 12 12 5 19 12"></polyline>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <footer>
            © 2026 Xybant AI. All Rights Reserved.
        </footer>
    </div>

    <div class="drawer-overlay" id="drawer-overlay"></div>
    <aside class="drawer" id="drawer" aria-hidden="true">
        <div>
            <div class="drawer-header">
                <h2 class="drawer-title">System Settings</h2>
                <button class="icon-btn" id="close-menu-btn" aria-label="Close Menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <p class="drawer-section-label">Session</p>
            <ul class="menu-items">
                <li class="menu-item" id="menu-new-chat">New Chat</li>
                <li class="menu-item" id="menu-export-chat">Export Chat History</li>
            </ul>

            <p class="drawer-section-label">Preferences</p>
            <ul class="menu-items">
                <li class="menu-item">
                    <span>Theme</span>
                    <select class="select-control" id="theme-select">
                        <option value="dark">Dark (Default)</option>
                        <option value="light">Light</option>
                    </select>
                </li>
                <li class="menu-item">
                    <span>AI Model</span>
                    <select class="select-control" id="model-select">
                        <option value="gemini-2.5-flash">Gemini 2.5 Flash</option>
                        <option value="gemini-2.5-pro">Gemini 2.5 Pro</option>
                    </select>
                </li>
                <li class="menu-item">
                    <span>Memory</span>
                    <select class="select-control" id="memory-select">
                        <option value="enabled">Enabled</option>
                        <option value="disabled">Disabled</option>
                    </select>
                </li>
            </ul>
        </div>

        <div>
            <p class="drawer-section-label">Information</p>
            <ul class="menu-items">
                <li class="menu-item" style="font-size: 0.85rem;">Privacy Policy</li>
                <li class="menu-item" style="font-size: 0.85rem;">About Xybant</li>
            </ul>
        </div>
    </aside>

    <script>
        /* ==========================================================================
           1. COLORFUL & GLOWING PARTICLE CANVAS
           ========================================================================== */
        class ParticleCanvas {
            constructor(canvasId) {
                this.canvas = document.getElementById(canvasId);
                this.ctx = this.canvas.getContext('2d');
                this.particles = [];
                this.particleCount = window.innerWidth < 640 ? 50 : 90;
                this.mouse = { x: null, y: null, radius: 120 };
                
                this.init();
                this.animate();
                
                let resizeTimeout;
                window.addEventListener('resize', () => {
                    clearTimeout(resizeTimeout);
                    resizeTimeout = setTimeout(() => this.resize(), 100);
                });

                window.addEventListener('mousemove', (e) => {
                    this.mouse.x = e.clientX;
                    this.mouse.y = e.clientY;
                });
            }

            init() {
                this.resize();
                this.particles = [];
                
                const colors = [
                    '59, 130, 246',
                    '139, 92, 246',
                    '236, 72, 153',
                    '6, 182, 212',
                    '168, 85, 247'
                ];
                
                for (let i = 0; i < this.particleCount; i++) {
                    this.particles.push({
                        x: Math.random() * this.canvas.width,
                        y: Math.random() * this.canvas.height,
                        radius: Math.random() * 2.6 + 2.2, 
                        vx: (Math.random() - 0.5) * 0.3,
                        vy: (Math.random() - 0.5) * 0.3,
                        baseAlpha: Math.random() * 0.45 + 0.35,
                        rgb: colors[Math.floor(Math.random() * colors.length)]
                    });
                }
            }

            resize() {
                this.canvas.width = window.innerWidth;
                this.canvas.height = window.innerHeight;
            }

            animate() {
                this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

                for (let p of this.particles) {
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = this.canvas.width;
                    if (p.x > this.canvas.width) p.x = 0;
                    if (p.y < 0) p.y = this.canvas.height;
                    if (p.y > this.canvas.height) p.y = 0;

                    let alpha = p.baseAlpha;
                    let currentRadius = p.radius;

                    if (this.mouse.x && this.mouse.y) {
                        let dx = this.mouse.x - p.x;
                        let dy = this.mouse.y - p.y;
                        let dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < this.mouse.radius) {
                            alpha = Math.min(1, p.baseAlpha + (1 - dist / this.mouse.radius) * 0.5);
                            currentRadius = p.radius * 1.3;
                        }
                    }

                    let gradient = this.ctx.createRadialGradient(
                        p.x, p.y, 0,
                        p.x, p.y, currentRadius * 2.5
                    );
                    
                    gradient.addColorStop(0, `rgba(${p.rgb}, ${alpha})`);
                    gradient.addColorStop(0.4, `rgba(${p.rgb}, ${alpha * 0.5})`);
                    gradient.addColorStop(1, `rgba(${p.rgb}, 0)`);

                    this.ctx.beginPath();
                    this.ctx.arc(p.x, p.y, currentRadius * 2.5, 0, Math.PI * 2);
                    this.ctx.fillStyle = gradient;
                    this.ctx.fill();

                    this.ctx.beginPath();
                    this.ctx.arc(p.x, p.y, currentRadius * 0.6, 0, Math.PI * 2);
                    this.ctx.fillStyle = `rgba(255, 255, 255, ${Math.min(1, alpha + 0.2)})`;
                    this.ctx.fill();
                }

                requestAnimationFrame(() => this.animate());
            }
        }

        /* ==========================================================================
           2. CONVERSATION PERSISTENCE ARCHITECTURE (LOCALSTORAGE)
           ========================================================================== */
        class StorageAdapter {
            static STORAGE_KEY = 'xybant_conversation_history_v1';

            static saveMessages(messages) {
                try {
                    localStorage.setItem(this.STORAGE_KEY, JSON.stringify(messages));
                } catch (e) {
                    console.error('Storage quota exceeded or disabled:', e);
                }
            }

            static loadMessages() {
                try {
                    const data = localStorage.getItem(this.STORAGE_KEY);
                    return data ? JSON.parse(data) : [];
                } catch (e) {
                    console.error('Failed to parse history:', e);
                    return [];
                }
            }

            static clearMessages() {
                localStorage.removeItem(this.STORAGE_KEY);
            }
        }

        /* ==========================================================================
           3. MAIN XYBANT APPLICATION CONTROLLER
           ========================================================================== */
        class XybantApp {
            constructor() {
                this.drawer = document.getElementById('drawer');
                this.overlay = document.getElementById('drawer-overlay');
                this.openMenuBtn = document.getElementById('open-menu-btn');
                this.closeMenuBtn = document.getElementById('close-menu-btn');
                this.chatInput = document.getElementById('chat-input');
                this.sendBtn = document.getElementById('send-btn');
                this.heroSection = document.getElementById('hero-section');
                this.chatFeed = document.getElementById('chat-feed');
                this.logoBtn = document.getElementById('logo-btn');
                this.newChatBtn = document.getElementById('menu-new-chat');
                this.exportChatBtn = document.getElementById('menu-export-chat');
                this.attachBtn = document.getElementById('attach-btn');
                this.fileInput = document.getElementById('file-input');
                this.attachmentPreview = document.getElementById('attachment-preview');
                this.attachmentName = document.getElementById('attachment-name');
                this.removeFileBtn = document.getElementById('remove-file-btn');
                this.micBtn = document.getElementById('mic-btn');
                this.themeSelect = document.getElementById('theme-select');

                this.messages = [];
                this.activeAttachment = null;
                this.isGenerating = false;
                this.recognition = null;

                this.init();
            }

            init() {
                this.bindEvents();
                this.setupSpeechRecognition();
                this.loadPersistedState();
                
                if (window.marked) {
                    marked.setOptions({
                        breaks: true,
                        gfm: true
                    });
                }
            }

            bindEvents() {
                this.openMenuBtn.addEventListener('click', () => this.toggleDrawer(true));
                this.closeMenuBtn.addEventListener('click', () => this.toggleDrawer(false));
                this.overlay.addEventListener('click', () => this.toggleDrawer(false));

                this.chatInput.addEventListener('input', () => {
                    this.adjustInputHeight();
                    this.sendBtn.disabled = this.chatInput.value.trim() === '' && !this.activeAttachment;
                });

                this.chatInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        this.handleSendMessage();
                    }
                });

                this.sendBtn.addEventListener('click', () => this.handleSendMessage());

                this.logoBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    this.resetConversation();
                });

                this.newChatBtn.addEventListener('click', () => {
                    this.resetConversation();
                    this.toggleDrawer(false);
                });

                this.exportChatBtn.addEventListener('click', () => this.exportHistory());

                this.attachBtn.addEventListener('click', () => this.fileInput.click());
                this.fileInput.addEventListener('change', (e) => this.handleFileSelection(e));
                this.removeFileBtn.addEventListener('click', () => this.clearAttachment());

                this.micBtn.addEventListener('click', () => this.toggleSpeechToText());

                this.themeSelect.addEventListener('change', (e) => {
                    document.documentElement.setAttribute('data-theme', e.target.value);
                });
            }

            toggleDrawer(open) {
                this.drawer.classList.toggle('active', open);
                this.overlay.classList.toggle('active', open);
                this.drawer.setAttribute('aria-hidden', !open);
            }

            adjustInputHeight() {
                this.chatInput.style.height = '24px';
                this.chatInput.style.height = Math.min(this.chatInput.scrollHeight, 140) + 'px';
            }

            handleFileSelection(e) {
                const file = e.target.files[0];
                if (!file) return;

                this.activeAttachment = { name: file.name, type: file.type };
                this.attachmentName.textContent = file.name;
                this.attachmentPreview.classList.add('active');
                this.sendBtn.disabled = false;
            }

            clearAttachment() {
                this.activeAttachment = null;
                this.fileInput.value = '';
                this.attachmentPreview.classList.remove('active');
                if (this.chatInput.value.trim() === '') {
                    this.sendBtn.disabled = true;
                }
            }

            setupSpeechRecognition() {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (!SpeechRecognition) {
                    this.micBtn.style.opacity = '0.3';
                    this.micBtn.title = "Speech recognition not supported by browser.";
                    return;
                }

                this.recognition = new SpeechRecognition();
                this.recognition.continuous = false;
                this.recognition.interimResults = false;

                this.recognition.onstart = () => this.micBtn.classList.add('listening');
                this.recognition.onend = () => this.micBtn.classList.remove('listening');
                
                this.recognition.onresult = (event) => {
                    const transcript = event.results[0][0].transcript;
                    this.chatInput.value += (this.chatInput.value ? ' ' : '') + transcript;
                    this.adjustInputHeight();
                    this.sendBtn.disabled = false;
                };
            }

            toggleSpeechToText() {
                if (!this.recognition) return;
                try {
                    this.micBtn.classList.contains('listening') ? this.recognition.stop() : this.recognition.start();
                } catch (e) {
                    console.error('Speech error:', e);
                }
            }

            async handleSendMessage() {
                if (this.isGenerating) return;

                const text = this.chatInput.value.trim();
                if (!text && !this.activeAttachment) return;

                const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const userMsg = {
                    sender: 'user',
                    text: text,
                    attachment: this.activeAttachment ? { ...this.activeAttachment } : null,
                    time: timestamp
                };

                this.messages.push(userMsg);
                StorageAdapter.saveMessages(this.messages);

                this.renderMessageBubble(userMsg);
                this.clearInputState();

                this.isGenerating = true;
                const typingNode = this.showTypingIndicator();

                try {
                    const responseText = await this.generateAIResponse(userMsg);
                    typingNode.remove();
                    
                    const aiMsg = {
                        sender: 'ai',
                        text: '',
                        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                    };

                    const bubbleNode = this.renderMessageBubble(aiMsg);
                    await this.streamResponseText(bubbleNode.querySelector('.message-bubble'), responseText, aiMsg);

                    this.messages.push(aiMsg);
                    StorageAdapter.saveMessages(this.messages);
                } catch (err) {
                    typingNode.remove();
                    this.renderMessageBubble({
                        sender: 'ai',
                        text: "Koi dikkat aayi hai reply generate karne mein. Please check your connection.",
                        time: timestamp
                    });
                } finally {
                    this.isGenerating = false;
                }
            }

            clearInputState() {
                this.chatInput.value = '';
                this.clearAttachment();
                this.adjustInputHeight();
                this.sendBtn.disabled = true;
            }

            /* --- NATURAL HUMAN CONVERSATIONAL REPLY LOGIC --- */
            async generateAIResponse(userMessage) {
                await new Promise(resolve => setTimeout(resolve, 600));

                const text = userMessage.text ? userMessage.text.toLowerCase().trim() : '';

                // Simple natural responses (Gemini API se pehle ke liye)
                if (text === 'hi' || text === 'hii' || text === 'hello' || text === 'hey' || text === 'heyy') {
                    const replies = [
                        "Hey! Kaise ho? Aaj main aapki kya help kar sakta hu?",
                        "Hello! Kya chal raha hai?",
                        "Hey there! Aaj kya poochhna chahte ho?"
                    ];
                    return replies[Math.floor(Math.random() * replies.length)];
                }

                if (text.includes('kaise ho') || text.includes('how are you')) {
                    return "Main ekdum badhiya hu! Aap batao, sab kaisa chal raha hai?";
                }

                if (text.includes('who are you') || text.includes('kaun ho') || text.includes('naam kya hai')) {
                    return "Mera naam **Xybant AI** hai. Aapka personal AI assistant!";
                }

                if (!text && userMessage.attachment) {
                    return `Aapka file **${userMessage.attachment.name}** mil gaya hai. Bataiye iska kya karna hai?`;
                }

                // Default natural reply
                return `Main samajh gaya! Aapne bola: "${userMessage.text}". Gemini API connect hone par main iska bilkul accurate aur detailed answer dunga.`;
            }

            async streamResponseText(containerNode, text, messageObj) {
                let currentText = '';
                const speed = 12;

                for (let i = 0; i < text.length; i++) {
                    currentText += text.charAt(i);
                    messageObj.text = currentText;
                    
                    containerNode.innerHTML = window.marked ? marked.parse(currentText) : currentText;
                    this.attachCodeCopyHandlers(containerNode);
                    this.chatFeed.scrollTop = this.chatFeed.scrollHeight;

                    await new Promise(r => setTimeout(r, speed));
                }
            }

            renderMessageBubble(msg) {
                this.heroSection.classList.add('minimized');
                this.chatFeed.classList.add('active');

                const row = document.createElement('div');
                row.className = `message-row ${msg.sender}`;

                let attachmentHTML = '';
                if (msg.attachment) {
                    attachmentHTML = `
                        <div class="message-attachment">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path></svg>
                            <span>${msg.attachment.name}</span>
                        </div>`;
                }

                const parsedContent = msg.text ? (window.marked ? marked.parse(msg.text) : msg.text) : '';

                row.innerHTML = `
                    <div class="message-bubble">
                        ${attachmentHTML}
                        ${parsedContent}
                    </div>
                    <div class="message-meta">
                        <span>${msg.time || ''}</span>
                    </div>
                `;

                this.chatFeed.appendChild(row);
                this.chatFeed.scrollTop = this.chatFeed.scrollHeight;
                this.attachCodeCopyHandlers(row);

                return row;
            }

            attachCodeCopyHandlers(container) {
                container.querySelectorAll('pre').forEach(pre => {
                    if (pre.querySelector('.copy-code-btn')) return;
                    
                    const btn = document.createElement('button');
                    btn.className = 'copy-code-btn';
                    btn.textContent = 'Copy';
                    btn.addEventListener('click', () => {
                        const code = pre.querySelector('code')?.innerText || pre.innerText;
                        navigator.clipboard.writeText(code);
                        btn.textContent = 'Copied!';
                        setTimeout(() => btn.textContent = 'Copy', 2000);
                    });
                    pre.appendChild(btn);
                });
            }

            showTypingIndicator() {
                const row = document.createElement('div');
                row.className = 'message-row ai';
                row.innerHTML = `
                    <div class="typing-indicator">
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                    </div>`;
                this.chatFeed.appendChild(row);
                this.chatFeed.scrollTop = this.chatFeed.scrollHeight;
                return row;
            }

            loadPersistedState() {
                const savedMessages = StorageAdapter.loadMessages();
                if (savedMessages && savedMessages.length > 0) {
                    this.messages = savedMessages;
                    savedMessages.forEach(msg => this.renderMessageBubble(msg));
                }
            }

            resetConversation() {
                StorageAdapter.clearMessages();
                this.messages = [];
                this.chatFeed.innerHTML = '';
                this.chatFeed.classList.remove('active');
                this.heroSection.classList.remove('minimized');
                this.clearInputState();
            }

            exportHistory() {
                const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(this.messages, null, 2));
                const downloadAnchor = document.createElement('a');
                downloadAnchor.setAttribute("href", dataStr);
                downloadAnchor.setAttribute("download", `xybant_chat_${Date.now()}.json`);
                document.body.appendChild(downloadAnchor);
                downloadAnchor.click();
                downloadAnchor.remove();
            }
        }

        /* ==========================================================================
           4. SERVICE WORKER REGISTRATION (PWA)
           ========================================================================== */
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                const swCode = `
                    const CACHE_NAME = 'xybant-v1';
                    self.addEventListener('install', (e) => {
                        e.waitUntil(caches.open(CACHE_NAME).then(cache => cache.addAll(['./'])));
                    });
                    self.addEventListener('fetch', (e) => {
                        e.respondWith(caches.match(e.request).then(res => res || fetch(e.request)));
                    });
                `;
                const blob = new Blob([swCode], { type: 'application/javascript' });
                navigator.serviceWorker.register(URL.createObjectURL(blob)).catch(() => {});
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            new ParticleCanvas('bg-canvas');
            new XybantApp();
        });
    </script>
